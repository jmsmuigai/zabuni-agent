# Copy to .env and adjust. Everything has a working default.
ZABUNI_PROVIDER=ollama                 # ollama (open weights, default) | anthropic | scripted (no model)
ZABUNI_OLLAMA_MODEL=qwen2.5:7b         # any Ollama model with tool calling: qwen2.5:14b, llama3.1:8b, mistral-nemo
OLLAMA_HOST=http://localhost:11434
ZABUNI_ANTHROPIC_MODEL=claude-sonnet-5-5   # only for the optional frontier comparison
# ANTHROPIC_API_KEY=...
ZABUNI_PRICE_IN_PER_MTOK=0             # USD per million input tokens, for cost-per-run on API models
ZABUNI_PRICE_OUT_PER_MTOK=0
ZABUNI_GATE_SECRET=change-me           # shared by the human gate and the MCP server; never given to the model
ZABUNI_SPLIT_THRESHOLD_KES=2000000     # set to the buyer's request-for-quotation ceiling
ZABUNI_CONCENTRATION_PCT=40
ZABUNI_EXTREME_VALUE_KES=50000000000
ZABUNI_MIN_COMPARABLES=5
ZABUNI_OUTLIER_Z=3.5
